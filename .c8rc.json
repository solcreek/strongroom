{
  "all": true,
  "extension": [
    ".ts"
  ],
  "include": [
    "service/**/*.ts",
    "packages/strongroom/src/**/*.ts"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/types.ts",
    "service/worker.ts",
    "service/node.ts"
  ],
  "reporter": [
    "text",
    "json-summary",
    "lcov"
  ],
  "check-coverage": true,
  "lines": 90,
  "statements": 90,
  "functions": 90,
  "branches": 80
}
