{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strongroom",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "STRONGROOM_ALLOW_LOCAL": "false" },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
