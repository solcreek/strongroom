{
  "name": "strongroom-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "check": "tsc --noEmit",
    "test": "npm run test:rust && npm run test:fast",
    "bench": "node scripts/bench.mjs",
    "bench:workers": "node scripts/workers.mjs",
    "bench:workerd": "node scripts/workerd.mjs",
    "report": "node scripts/report.mjs",
    "start:ts": "node --experimental-strip-types poc/typescript/server.ts",
    "build:poc": "node scripts/build.mjs",
    "test:poc": "node scripts/build.mjs && node --test tests/crypto.test.mjs",
    "build:host": "node scripts/build-service.mjs && node scripts/build-sdk.mjs",
    "test:rust": "node scripts/test-rust.mjs",
    "test:fast": "node --test tests/service.test.mjs tests/providers.test.mjs tests/sdk.test.mjs tests/cli.test.mjs tests/runtime.test.mjs",
    "coverage": "c8 npm run test:fast",
    "verify": "npm run build && npm run check && npm run test:rust && npm run coverage",
    "dev:init": "node packages/strongroom/dist/cli.js init",
    "dev": "node scripts/dev.mjs",
    "dev:node": "node --env-file=.strongroom/server.env dist/server.js",
    "cli": "node packages/strongroom/dist/cli.js",
    "deploy:check": "wrangler deploy --config wrangler.jsonc --dry-run --outdir dist/deploy",
    "start": "node dist/server.js",
    "test:transit": "node scripts/test-transit.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:container": "node scripts/test-container.mjs",
    "image": "node scripts/image.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "c8": "10.1.3",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "wrangler": "^4.150.0"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  },
  "engines": {
    "node": ">=24"
  }
}
